    {
      "parameters": {
        "jsCode": "// Collapses the named orders into the payload the dashboard renders.\n//\n// This runs on the output of \"Order id generation\", so product_name is exactly\n// the key the real run passes to claim_intake_order — the preview and the run\n// cannot disagree about what an order is called.\n//\n// Nothing is written here. The only side effect of a dry run is one row in\n// project_intake_previews, written by the app when the callback lands.\nconst inputs = $('Set Inputs').first().json;\n\nconst expected_orders = items.map(item => {\n  const brief = item.json.brief || '';\n  const countMatch = brief.match(/consists of\\s+(\\d+)×/i);\n\n  return {\n    product_name: item.json.projectType,\n    task_name: item.json.projectName,\n    quantity: countMatch ? Number(countMatch[1]) : 1,\n    brief,\n  };\n});\n\nreturn [{\n  json: {\n    job_id: inputs.job_id,\n    project_id: inputs.project_id,\n    status: 'completed',\n    expected_orders,\n  },\n}];\n"
      },
      "name": "Build dry-run result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1648, 24],
      "id": "b1d4f2a0-0003-4c11-9f21-aa0000000003"
    },
